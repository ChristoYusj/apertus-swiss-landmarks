# Copy to .env (never commit .env). Only needed for LIVE runs; `make run` replays offline without keys.
LLM_NAME=swiss-ai/Apertus-v1.5-70B
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=
# Optional independent judge (OpenAI-compatible). Without it the deterministic code grader is used.
JUDGE_MODEL=openai/gpt-oss-120b
JUDGE_BASE_URL=https://router.huggingface.co/v1
JUDGE_API_KEY=
# Optional
LLM_CONCURRENCY=4
SAMPLE=150
